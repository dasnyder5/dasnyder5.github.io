@phdthesis{snyder_nonasymptotic_2025,
  title={Nonasymptotic Methods for Guaranteed Robotic Policy Synthesis and Evaluation},
  preview={},
  abstract={In the past decade, robotics research has undergone an unremittingly Schumpeterian evolution, manifesting far-reaching and rapid progress throughout the field. Entire analytical paradigms, developed over decades, have been superseded in empirical performance by novel advances leveraging vast amounts of newly available computation and training data. As a result, current robots are capable of complex, dexterous behaviors which empirically generalize across significant variation in task settings and environments. However, not all is solved; robots which appear to be robust often demonstrate brittle and unpredictable behavior in otherwise benign settings, where small, task-irrelevant fluctuations derail desired system behavior. Without reliable assurances that these autonomous systems are themselves reliable, the potential for deployment to address real-world problems remains fundamentally limited. To further the goal of deploying robots with assured safety and reliability, this dissertation constructs rigorous, interpretable, and implementable guarantees for robotic systems which account for the practical constraints imposed by the empirical nature of the robotics discipline. These guarantees are directed towards two critical ends: (1) policy synthesis, or guarantees on a property of the robot’s decision-making rule; and (2) policy evaluation, or guarantees on a property of an evaluator’s decision-making process. The core challenge in robotics — and in synthesizing guarantees about robots — is the presence of significant, often-irreducible uncertainty in the operating environment. Robots must maintain rich sensor observations to interpret and interact with external objects, which themselves may be reasoning agents capable of adversarial (or collaborative) behaviors. The roboticist cannot arbitrarily reduce uncertainty by pre-filtering what the robot observes, and the representation of the robot’s uncertainty thus matters enormously. Under stochastic uncertainty, we focus on evaluation, including the development of provably near-optimal sequential procedures for comparing robot policies, and online failure predictors with guaranteed class-conditional correctness. Under nonstochastic uncertainty, we develop online learning procedures which construct robust disturbance generators and obstacle avoidance controllers. In each setting, guarantees are tailored to the small-data regime and enforce nonasymptotic (finite-sample) assurances. These methods represent important steps toward understanding the nature of uncertainty ``in the robot’s world,’’ which is necessary for future deployment of safe, reliable robots capable of addressing practical problems.},
  author={Snyder, David},
  year={2025},
  school={Princeton University},
  thesis={true}
}